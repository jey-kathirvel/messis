# Required production settings for passcode-reset email delivery.
# Hostinger commonly supports SMTP over SSL on port 465; confirm with the mailbox provider.
PUBLIC_BASE_URL=https://messis.ads-ai.in
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=replace-with-mailbox-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_SSL=true
SMTP_USE_TLS=false
PASSCODE_RESET_MINUTES=30
PASSCODE_RESET_MAX_ATTEMPTS=5
