# ============================================================
# Messis AI - Git Ignore
# FastAPI / Python / PostgreSQL / Jinja2 / Tailwind
# ============================================================

# ------------------------------------------------------------
# Environment and secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.env
secrets/
secret/
*.secret
*.key
*.pem
*.p12
*.pfx
credentials.json
service-account*.json

# ------------------------------------------------------------
# Python virtual environments
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# ------------------------------------------------------------
# Python cache and compiled files
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/
.nox/

# ------------------------------------------------------------
# Python packaging
# ------------------------------------------------------------
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------
# Application runtime files
# ------------------------------------------------------------
*.pid
*.pid.lock
*.sock
*.lock
run/
runtime/
tmp/
temp/
.cache/

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
logs/
log/
*.log
*.log.*
*.out
*.err
nohup.out
uvicorn*.log
gunicorn*.log
messis-backup.log
messis-health.log

# ------------------------------------------------------------
# Database files and dumps
# ------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.sql
*.dump
*.backup
*.pgdump
postgres-data/
pgdata/

# Keep approved database scripts
!scripts/*.sql
!database/*.sql
!db/*.sql

# ------------------------------------------------------------
# Backups and archives
# ------------------------------------------------------------
backup/
backups/
_backup/
_backups/
*.bak
*.bak.*
*.backup.*
*.old
*.orig
*.save
*.swp
*.swo
*~
*.tmp
*.temp

*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.7z
*.rar

# Patch-generated timestamped backups
*.PATCH-*.bak*
*.patch-*.bak*
*.pre-patch*
*.post-patch*
*.rollback*
*.backup-20*
*.bak-20*
*.bak.20*

# ------------------------------------------------------------
# Uploaded and generated user content
# ------------------------------------------------------------
uploads/
media/
storage/
generated/
exports/
reports/generated/
static/uploads/
app/static/uploads/

# Keep empty directories where required
!uploads/.gitkeep
!media/.gitkeep
!storage/.gitkeep
!exports/.gitkeep

# ------------------------------------------------------------
# Frontend / Node / Tailwind
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/cache/
.yarn/unplugged/
.pnpm-store/
.parcel-cache/
.next/
out/
.nuxt/
.svelte-kit/
vite.config.*.timestamp-*
tailwind-output.css
app/static/css/tailwind-output.css
static/css/tailwind-output.css

# Keep production compiled CSS if intentionally committed
!app/static/css/app.css
!static/css/app.css

